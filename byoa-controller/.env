# ── BYOA Platform Controller — .env ──────────────────────────────────────────
# Fill in the two secrets/URL below with your real values -- these are the
# only ones I don't know. Everything else reflects the port table you gave.

PLATFORM_DB_URL=postgresql://byoa_admin:alpine123@localhost:5432/byoa_platform_v6-1
BYOA_SECRET=byoa-dev-secret-change-in-prod5

# ── Networking / public identity ─────────────────────────────────────────────
PORT=4301
AGENT_ENDPOINT=https://controller7.zackloh.dev

# ── Ollama (goal expansion planning model) ───────────────────────────────────
OLLAMA_MODEL=qwen3.6:35b-a3b-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434

# ── vLLM (if this is the actual inference path expand_goal() calls) ─────────
#VLLM_BASE_URL=http://localhost:11500
#VLLM_MODEL=qwen3.6-35b-fp8

# ── Orchestration tuning ──────────────────────────────────────────────────────
MAX_PARALLEL_AGENTS=2
AGENT_CALL_TIMEOUT=600
PLAN_TTL_SECS=6000

# ── Knowledge base ingestion (byoa-rag-ingest3 / controller6.zackloh.dev) ──────
# Controller calls this directly over localhost as a pre-processing step for
# any files attached to a /goal request -- NOT through the Cloudflare
# hostname, and NOT through the registered_agents dispatch path (that's only
# for the knowledge-retrieve AGENT behind controller6.zackloh.dev, port 9406,
# which is unaffected by this file and needs no entry here).
KNOWLEDGE_BASE_URL=http://localhost:4405
KNOWLEDGE_INGEST_PATH=/ingest
# You still need to add this endpoint to the ingest agent -- DELETE at this
# path should remove every doc tagged with that session_id. Adjust the path
# here (and the requests.delete(...) call in purge_session_docs()) once you've
# settled on the real path/method for it.
KNOWLEDGE_SESSION_PURGE_PATH_TEMPLATE=/session/{session_id}
UPLOAD_INGEST_TIMEOUT=6000
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BYTES=10737418241073741824

FEEDBACK_BASE_URL=http://localhost:4405
FEEDBACK_QUERY_TIMEOUT_SECS=3
FEEDBACK_SUBMIT_TIMEOUT_SECS=10
FEEDBACK_GOOD_EXEMPLARS=2
FEEDBACK_BAD_EXEMPLARS=2
FEEDBACK_GOOD_RATING_MIN=4
FEEDBACK_BAD_RATING_MAX=2
COMPLETED_GOAL_TTL_SECS=86400
