PLATFORM_DB_URL=postgresql://user:pass@localhost:5432/dbname
# At least 32 random characters, e.g.: python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_JWT_SECRET=
PORT=4150
ADMIN_HOST=127.0.0.1
REGISTRATION_URL=http://localhost:4100
# Flutter web origin(s), comma separated. No wildcard.
ADMIN_CORS_ORIGINS=http://localhost:8080
# Model used by "AI assist" in the code editor (fills the TODO sections of agent.py).
VLLM_BASE_URL=http://localhost:11500
VLLM_MODEL=qwen3.6-35b-fp8
GEN_CONCURRENCY=2
